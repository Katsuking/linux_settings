if [ "$EUID" -eq 0 ]; then
    export PS1='\[\033[01;33m\]\w\n\[\033[41;97m\] ROOT \[\033[00m\]\[\033[01;31m\]#\[\033[00m\] '
else
    export PS1='\[\033[01;33m\]\w\n\[\033[01;34m\]\u\[\033[00m\] \$ '
fi

umask 077 # root が作るファイルはデフォで厳しくする


# alias

alias ll='ls -al'
alias bashrc="vim ~/.bashrc && source ~/.bashrc"
